# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored — never commit real values.

# ── Google Drive ingestion ────────────────────────────────────────────────────

# ID of the Drive folder holding incoming invoice PDFs.
# From the folder URL: https://drive.google.com/drive/folders/<THIS_PART>
GDRIVE_FOLDER_ID=

# OAuth client — choose ONE of the two ways:
#
#   (A) Put the client id/secret here (no credentials.json file needed).
#       Copy them from the "installed" section of the downloaded JSON.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
#
#   (B) Or leave the two above empty and point to the credentials.json file.
#       Relative paths are resolved against the project root.
GDRIVE_CREDENTIALS_FILE=credentials.json

# Where the cached OAuth token is stored (created automatically after login).
GDRIVE_TOKEN_FILE=token.json
